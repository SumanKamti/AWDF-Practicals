# ==============================================================================
# AWDF Full-Stack Portfolio & Task Management - Environment Template
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Backend Service Configuration (Render Web Service)
# ------------------------------------------------------------------------------
PORT=5000
NODE_ENV=production
JWT_SECRET=your_jwt_secret_key_here

# Allowed CORS Origins (comma-separated for multiple origins, e.g. Vercel + localhost)
CLIENT_URL=https://your-portfolio.vercel.app,http://localhost:5173

# ------------------------------------------------------------------------------
# 2. Database Connection (MongoDB Atlas Cloud)
# ------------------------------------------------------------------------------
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxx.mongodb.net/MyPortfolioToDo?retryWrites=true&w=majority

# ------------------------------------------------------------------------------
# 3. Frontend Client Configuration (Vercel Project Settings)
# ------------------------------------------------------------------------------
# Public API base URL pointing to your deployed Render backend (no trailing slash)
VITE_API_BASE_URL=https://your-backend.onrender.com

# Google OAuth Client ID for browser Google Identity Services (GSI)
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com

# ------------------------------------------------------------------------------
# 4. Nodemailer SMTP Email Service (Render Web Service)
# ------------------------------------------------------------------------------
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_email_app_password_here

# ------------------------------------------------------------------------------
# 5. Google OAuth 2.0 Token Verification (Render Web Service)
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# ------------------------------------------------------------------------------
# 6. Google Gemini AI Integration (Render Web Service)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# ------------------------------------------------------------------------------
# 7. Optional DNS Resolver Override (Docker Alpine environments only)
# ------------------------------------------------------------------------------
# DNS_SERVERS=8.8.8.8,8.8.4.4
