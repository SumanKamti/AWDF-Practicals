# ==============================================================================
# AWDF Backend Environment Template (Render Web Service)
# ==============================================================================

# Server Configuration
PORT=5000
NODE_ENV=production

# JWT Authentication Secret Key (Required: Generate a strong secret)
JWT_SECRET=your_strong_jwt_secret_key_here

# Cloud Database Connection String (MongoDB Atlas Cloud Only)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxx.mongodb.net/MyPortfolioToDo?retryWrites=true&w=majority
CLOUD_DB_URI=mongodb+srv://<username>:<password>@cluster0.xxxx.mongodb.net/MyPortfolioToDo?retryWrites=true&w=majority

# Allowed CORS Origins (comma-separated, e.g. production Vercel + local development)
CLIENT_URL=https://your-portfolio.vercel.app,http://localhost:5173

# Nodemailer SMTP Email Service (Used for OTP dispatch and portfolio contact messages)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_email_app_password_here

# Google OAuth 2.0 (Used for backend token audience validation in /auth/google)
GOOGLE_CLIENT_ID=your_google_oauth_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret_here

# Google Gemini AI Integration (Practical 13)
# Primary model: gemini-3.8-flash (automatic zero-downtime fallback to gemini-2.5-flash during demand spikes)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# Optional: Custom DNS Resolvers (Only needed in environments with broken SRV lookups like Alpine Docker)
# DNS_SERVERS=8.8.8.8,8.8.4.4
