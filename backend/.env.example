# Server Configuration
PORT=5000
NODE_ENV=development

# Database Mode Selection: "cloud" for MongoDB Atlas, or "local" for Local MongoDB
DB_TYPE=cloud

# Cloud Database URI (MongoDB Atlas)
CLOUD_DB_URI=mongodb+srv://<username>:<password>@cluster0.xxxx.mongodb.net/<database_name>?retryWrites=true&w=majority

# Local Database URI (Local MongoDB)
LOCAL_DB_URI=mongodb://127.0.0.1:27017/MyPortfolioToDo

# Frontend Client URL (for CORS)
CLIENT_URL=http://localhost:5173
