# Server Configuration
PORT=5000
NODE_ENV=development

# Cloud Database URI (MongoDB Atlas Only)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxx.mongodb.net/<database_name>?retryWrites=true&w=majority
CLOUD_DB_URI=mongodb+srv://<username>:<password>@cluster0.xxxx.mongodb.net/<database_name>?retryWrites=true&w=majority

# JWT Secret Key
JWT_SECRET=your_strong_jwt_secret_key_here

# Frontend Client URL (for CORS)
CLIENT_URL=http://localhost:5173

# Google Gemini AI Integration (Practical 13)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
